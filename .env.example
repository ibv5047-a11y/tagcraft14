# Neon Postgres connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign login cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic API key for the listing generator
ANTHROPIC_API_KEY=

# Optional: override the model used by /api/generate
# ANTHROPIC_MODEL=claude-sonnet-5-5
